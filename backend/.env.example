# Environment Configuration Example
# Copy this file and rename based on your environment:
# - .env.development (local development with SQLite)
# - .env.production (production deployment)
# - .env.docker (Docker Compose - stored in project root)

# =============================================================================
# ENVIRONMENT SELECTION
# =============================================================================
# Options: development | production | docker
APP_ENV=development

# =============================================================================
# DATABASE
# =============================================================================
# Development: SQLite (no external dependencies)
DATABASE_URL=sqlite+aiosqlite:///./app.db

# Production: PostgreSQL
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DATABASE

# Docker: Set via docker-compose.yml environment variables
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/app

# =============================================================================
# REDIS & CELERY
# =============================================================================
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# =============================================================================
# JWT AUTHENTICATION
# =============================================================================
# WARNING: In production, SECRET_KEY MUST be changed to a secure random value
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# =============================================================================
# OPENAI API
# =============================================================================
OPENAI_API_KEY=your-openai-api-key-here

# =============================================================================
# CORS (Cross-Origin Resource Sharing)
# =============================================================================
# Development: Permissive for local testing
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://127.0.0.1:3000"]

# Production: Restrict to your domain only
# CORS_ORIGINS=["https://yourdomain.com","https://www.yourdomain.com"]

# =============================================================================
# APPLICATION
# =============================================================================
APP_NAME=AI System API
APP_VERSION=0.1.0
DEBUG=false
